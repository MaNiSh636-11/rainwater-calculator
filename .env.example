# ==============================================================================
# Environment Configuration Template: Rainwater Harvesting Calculator
# ==============================================================================

# Backend Configuration (FastAPI)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (Vite + React)
# In local development with Vite proxy, leave empty or set to http://localhost:8000
# In AWS production, set to your EC2 ALB or API Gateway endpoint (e.g., https://api.aquaharvest.example.com)
VITE_API_BASE_URL=http://localhost:8000

# AWS Production Deployment (Reference only)
# AWS_REGION=us-east-1
# S3_BUCKET_FRONTEND=aquaharvest-web-production
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
